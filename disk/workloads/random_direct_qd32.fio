[global]
# Storage workload: random 4-KiB, bypass page cache; shared 1 GiB range for both implementations.
rw=randread
# Uniform sampling with replacement on both architectures.
norandommap=1
randrepeat=1
bs=4k
size=1g
direct=1
invalidate=1
group_reporting=0
thread=1
time_based=1
# Runtime and ramp are supplied by disk/scripts/run_disk.sh.

[random_direct]
